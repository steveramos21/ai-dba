# AI-DBA Configuration
# Two formats supported:

# 1. Connection URL (recommended — works with cloud providers)
engines:
  mysql-prod:
    type: mysql
    url: mysql://readonly:***@prod-db.internal:3306/app_db?ssl=true

  # 2. Individual fields (legacy, for local/dev)
  mysql-dev:
    type: mysql
    host: 127.0.0.1
    port: 3306
    user: root
    password: yourpassword
    database: yourdb